{
  "name": "kochi-traffic-prediction-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "verify:provider": "node scripts/verify-provider.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test": "node --experimental-sqlite --experimental-strip-types --test",
    "dev": "node --experimental-strip-types scripts/dev.mjs",
    "dev:worker": "node scripts/worker.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "cloudflare:login": "node scripts/cloudflare.mjs login",
    "cloudflare:status": "node scripts/cloudflare.mjs whoami",
    "cloudflare:migrate": "node scripts/cloudflare.mjs migrate",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "dependencies": {
    "maplibre-gl": "6.16.0"
  }
}
