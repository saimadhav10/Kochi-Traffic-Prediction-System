{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kochi-traffic",
  "account_id": "c5e450a193832c916b814309eb2a8a6b",
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PUBLIC_ACCESS_ENABLED": "true" },
  "triggers": { "crons": ["17 * * * *"] },
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "secrets": {
    "required": ["TOMTOM_API_KEY", "QUOTA_SALT"],
  },
  "observability": {
    "enabled": false,
  },
  "d1_databases": [
    {
      "binding": "QUOTA_DB",
      "database_name": "kochi-traffic-quotas",
      "database_id": "cf518370-8faf-4b7b-a393-decafbca38b4",
    },
  ],
}
